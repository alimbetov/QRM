# Copy as deploy/staging/private.env; NEVER commit the filled file.
# Use a DNS hostname pointing to your isolated staging server, with open TCP 80/443.
STAGING_DOMAIN=staging.example.invalid

# Generate each password independently: openssl rand -base64 36
ZAKAZ_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
KC_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
KC_ADMIN_USER=REPLACE_WITH_NON_DEFAULT_ADMIN_NAME
KC_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD

# openssl rand -base64 32; this is a secret encryption key for guest leads.
ZAKAZ_LEADS_PHONE_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# openssl rand -base64 32; independent encryption key for unverified buyer contact.
ZAKAZ_IDENTITY_PHONE_KEY_BASE64=REPLACE_WITH_DIFFERENT_BASE64_OF_32_RANDOM_BYTES

# P0 dual-user staging qualification. These controls remain OFF until reviewed.
# Consent does NOT itself create invitations; an autonomous candidate/delivery
# workflow must be separately proven before USER_E2E_VERIFIED is possible.
ZAKAZ_SELLER_WORKSPACE_ENABLED=false
ZAKAZ_SELLER_STUDIO_ENABLED=false
ZAKAZ_SELLER_BID_WORKSPACE_ENABLED=false
ZAKAZ_ML_R2_INVITATION_EVALUATION_ENABLED=false
ZAKAZ_ML_R2_CONSENT_API_ENABLED=false
ZAKAZ_ML_R2_DELIVERY_ENABLED=false
