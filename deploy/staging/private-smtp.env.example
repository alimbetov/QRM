# Append these values to ignored deploy/staging/private.env (NOT to Git).
# Keycloak SMTP port 587 requires STARTTLS; 465 requires implicit SSL.
# Keycloak 26.8.2 refuses STARTTLS downgrade.
STAGING_SMTP_HOST=smtp.example.invalid
STAGING_SMTP_PORT=587
STAGING_SMTP_MODE=starttls
STAGING_SMTP_FROM=not-reply@example.invalid
STAGING_SMTP_USER=REPLACE_WITH_PROVIDER_ACCOUNT
STAGING_SMTP_PASSWORD=REPLACE_WITH_PRIVATE_PROVIDER_SECRET
# Set only after successful Keycloak SMTP test and REAL mailbox receipt:
STAGING_ALLOW_SELF_REGISTRATION=DISABLED
# Optional: admin token from MFA-backed login can replace admin-cli password.
# STAGING_ADMIN_TOKEN_FILE=/evidence/admin.token
