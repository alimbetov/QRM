# Isolated staging only; Java 21, no local profile or dev auth bypass.
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY backend/pom.xml pom.xml
RUN mvn -B -q dependency:go-offline
COPY backend/src src
RUN mvn -B -q -DskipTests package

FROM eclipse-temurin:21-jre-noble
WORKDIR /app
RUN groupadd -g 10001 zakaz && useradd -u 10001 -g zakaz -s /usr/sbin/nologin -M zakaz
COPY --from=build /src/target/zakaz-backend-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java","-XX:MaxRAMPercentage=70","-jar","/app/app.jar"]
