# HTTPS is terminated by Caddy; the UI only uses same-origin /api.
FROM node:22-alpine AS build
WORKDIR /src
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web/ .
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID=zakaz-buyer-web
ARG VITE_SELLER_OIDC_AUTHORITY
ARG VITE_SELLER_OIDC_CLIENT_ID=zakaz-seller-web
ARG VITE_SELLER_WORKSPACE_ENABLED=false
ARG VITE_SELLER_BID_WORKSPACE_ENABLED=false
ARG VITE_ML_R2_CONSENT_UI_ENABLED=false
ENV VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
ENV VITE_SELLER_OIDC_AUTHORITY=${VITE_SELLER_OIDC_AUTHORITY}
ENV VITE_SELLER_OIDC_CLIENT_ID=${VITE_SELLER_OIDC_CLIENT_ID}
ENV VITE_SELLER_WORKSPACE_ENABLED=${VITE_SELLER_WORKSPACE_ENABLED}
ENV VITE_SELLER_BID_WORKSPACE_ENABLED=${VITE_SELLER_BID_WORKSPACE_ENABLED}
ENV VITE_ML_R2_CONSENT_UI_ENABLED=${VITE_ML_R2_CONSENT_UI_ENABLED}
RUN npm run build

FROM caddy:2.10-alpine
COPY --from=build /src/dist /srv
COPY deploy/staging/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
